  "components": {
    "schemas": {
      "BuyStockDto": {
        "required": [
          "quantity",
          "symbol"
        ],
        "type": "object",
        "properties": {
          "symbol": {
            "minLength": 1,
            "type": "string"
          },
          "quantity": {
            "minimum": 0.0001,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "ConvertCurrencyDto": {
        "required": [
          "amount",
          "fromCurrency",
          "toCurrency"
        ],
        "type": "object",
        "properties": {
          "fromCurrency": {
            "maxLength": 10,
            "minLength": 1,
            "type": "string"
          },
          "toCurrency": {
            "maxLength": 10,
            "minLength": 1,
            "type": "string"
          },
          "amount": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "GeneralPaymentDto": {
        "required": [
          "amount",
          "category",
          "pinCode",
          "recipientLabel"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "pinCode": {
            "maxLength": 4,
            "minLength": 4,
            "pattern": "^\\d{4}$",
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/TransactionCategory"
          },
          "recipientLabel": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 200,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterDto": {
        "required": [
          "cardHolderName",
          "cardNumber",
          "email",
          "fullName",
          "password",
          "personalNumber"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "personalNumber": {
            "minLength": 1,
            "pattern": "^\\d{11}$",
            "type": "string"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          },
          "cardNumber": {
            "minLength": 1,
            "pattern": "^\\d{16}$",
            "type": "string"
          },
          "cardHolderName": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SellStockDto": {
        "required": [
          "quantity",
          "symbol"
        ],
        "type": "object",
        "properties": {
          "symbol": {
            "minLength": 1,
            "type": "string"
          },
          "quantity": {
            "minimum": 0.0001,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "TransactionCategory": {
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ],
        "type": "integer",
        "format": "int32"
      },
      "TransferToOwnAccountDto": {
        "required": [
          "amount"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "description": {
            "maxLength": 200,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "TransferToPersonDto": {
        "required": [
          "amount",
          "pinCode",
          "recipientPersonalNumber"
        ],
        "type": "object",
        "properties": {
          "recipientPersonalNumber": {
            "minLength": 1,
            "type": "string"
          },
          "amount": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "pinCode": {
            "maxLength": 4,
            "minLength": 4,
            "pattern": "^\\d{4}$",
            "type": "string"
          },
          "description": {
            "maxLength": 200,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Enter your JWT token.",
        "scheme": "Bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}